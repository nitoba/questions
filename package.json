{
  "name": "@nitoba/questions",
  "version": "0.1.0-alpha.2",
  "description": "Typed semantic decisions and native Web Streams, without Effect.",
  "license": "MIT",
  "author": "Bruno Alves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/questions.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./streams": {
      "types": "./dist/streams.d.ts",
      "import": "./dist/streams.js"
    },
    "./providers/jev": {
      "types": "./dist/providers/jev.d.ts",
      "import": "./dist/providers/jev.js"
    },
    "./package.json": "./package.json",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "bun run --bun tsdown && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run build && bun run test:package",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.83.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
