{
  "name": "@nitoba/questions",
  "version": "0.1.0-rc.2",
  "description": "Typed semantic decisions for TypeScript with Zod, AI SDK providers, and native Web Streams.",
  "keywords": [
    "ai",
    "ai-sdk",
    "classification",
    "decision",
    "jev",
    "llm",
    "structured-output",
    "typescript",
    "web-streams",
    "zod"
  ],
  "homepage": "https://github.com/nitoba/questions#readme",
  "bugs": {
    "url": "https://github.com/nitoba/questions/issues"
  },
  "license": "MIT",
  "author": "Bruno Alves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/questions.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./streams": {
      "types": "./dist/streams.d.ts",
      "import": "./dist/streams.js"
    },
    "./providers/jev": {
      "types": "./dist/providers/jev.d.ts",
      "import": "./dist/providers/jev.js"
    },
    "./package.json": "./package.json",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./providers/typesafe": {
      "types": "./dist/providers/typesafe.d.ts",
      "import": "./dist/providers/typesafe.js"
    },
    "./providers/system-one": {
      "types": "./dist/providers/system-one.d.ts",
      "import": "./dist/providers/system-one.js"
    },
    "./providers/ai-sdk": {
      "types": "./dist/providers/ai-sdk.d.ts",
      "import": "./dist/providers/ai-sdk.js"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel.d.ts",
      "import": "./dist/providers/vercel.js"
    },
    "./duration": {
      "types": "./dist/duration.d.ts",
      "import": "./dist/duration.js"
    },
    "./providers/generative": {
      "types": "./dist/providers/generative.d.ts",
      "import": "./dist/providers/generative.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "bun run --bun tsdown && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run build && bun run test:package && node scripts/check-readme-examples.mjs && node scripts/check-example-links.mjs",
    "test:package": "node scripts/package-smoke.mjs && node scripts/sdk-package-smoke.mjs && node scripts/generative-package-smoke.mjs",
    "test:package:native": "node scripts/package-smoke.mjs",
    "test:examples": "bun test ./examples/tests && node scripts/check-example-links.mjs",
    "test:docs": "bun run build && node scripts/check-readme-examples.mjs && node scripts/check-example-links.mjs",
    "prepublishOnly": "bun run check",
    "release:dry-run": "npm publish --dry-run --access public --tag next"
  },
  "dependencies": {
    "ms": "2.1.3",
    "ofetch": "1.5.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.56",
    "@ai-sdk/gateway": "4.0.85",
    "@ai-sdk/google": "4.0.74",
    "@ai-sdk/openai": "4.0.69",
    "@ai-sdk/provider": "4.0.17",
    "@types/bun": "1.4.2",
    "@types/json-schema": "7.0.15",
    "@types/ms": "2.1.0",
    "ai": "7.0.105",
    "oxfmt": "0.66.0",
    "oxlint": "1.83.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@ai-sdk/gateway": "^4.0.85",
    "@ai-sdk/provider": "^4.0.17",
    "ai": "^7.0.105",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/gateway": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ai-sdk/provider": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
