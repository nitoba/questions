# Copy to a gitignored .env, or export only the variables needed for one tutorial.
# No example silently falls back to a fake provider.
QUESTIONS_PROVIDER=typesafe
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
EXAMPLE_TIMEOUT=20 seconds

# Tutorial 11: another paid request, disabled unless exactly 1.
COMPARE_WITH_VERCEL=0

# Tutorial 12's system-one mode: this must implement System One, not an arbitrary chat API.
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_API_KEY=

# Capstone. Use the SAME database path and token in each shell.
DESK_DB=.data/fulfillment-desk.sqlite
DESK_PORT=3131
DESK_TOKEN=
WEBHOOK_URL=http://127.0.0.1:3131/notifications
WEBHOOK_TOKEN=
