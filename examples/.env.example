# Copy to a gitignored .env, or export only the settings for one run. Never commit credentials.
# Most tutorials + capstone paid commands: typesafe (default) | vercel | generative.
# vercel = Jev evaluation. generative + gateway = a Gateway LANGUAGE model.
QUESTIONS_PROVIDER=typesafe
EXAMPLE_TIMEOUT=20 seconds
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=

# Used only when QUESTIONS_PROVIDER=generative, or by the dedicated lesson 17.
# google | anthropic | openai | gateway. Select an explicit structured-output-capable model.
GENERATIVE_PROVIDER=
GENERATIVE_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Lesson 11: third paid evaluation, disabled when COMPARE_PROVIDER is UNSET.
# COMPARE_PROVIDER=generative
# COMPARE_GENERATIVE_PROVIDER=google
# COMPARE_GENERATIVE_MODEL=your-structured-output-model-id
# Use the chosen vendor's key variable above. No implicit reuse of the primary model settings.
# COMPARE_PROVIDER can also be typesafe or vercel. Older alias COMPARE_WITH_VERCEL=1 is supported;
# never combine it with COMPARE_PROVIDER.

# Lesson 12 system-one mode: System One protocol, not an arbitrary chat API.
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_API_KEY=

# Capstone. Keep the SAME database path and token in every shell.
# Ingest/report/serve/review/deliver need no model credentials.
DESK_DB=.data/fulfillment-desk.sqlite
DESK_PORT=3131
DESK_TOKEN=
WEBHOOK_URL=http://127.0.0.1:3131/notifications
WEBHOOK_TOKEN=
